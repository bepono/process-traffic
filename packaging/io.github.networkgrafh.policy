<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Process Traffic</vendor>
  <action id="io.github.networkgrafh.admin">
    <description>See every process's network connections and use firewall controls</description>
    <message>Process Traffic needs your password to see all network connections, read the firewall log and block connections</message>
    <icon_name>io.github.networkgrafh</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/process-traffic/collector-root</annotate>
  </action>
</policyconfig>
